{
  "name": "wattpad-archiver",
  "version": "0.1.0",
  "private": true,
  "description": "Archive a Wattpad library as EPUBs. CLI and MCP server.",
  "license": "MIT",
  "author": "Daniel Phan",
  "bin": {
    "wattpad-archiver": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "node src/bin.ts",
    "build": "vp pack",
    "start": "node dist/bin.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "lint": "vp lint --report-unused-disable-directives",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@effect/platform-node": "^4.0.6",
    "dom-serializer": "^3.1.1",
    "domhandler": "^6.0.1",
    "effect": "^4.0.6",
    "fflate": "^0.8.3",
    "htmlparser2": "^12.0.0",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@effect/vitest": "^4.0.6",
    "@oxlint/plugins": "^1.90.0",
    "@types/node": "^26.6.5",
    "typescript": "npm:@tsc-rs/typescript@0.8.0",
    "vite-plus": "^1.4.0"
  },
  "engines": {
    "node": ">=24"
  }
}
